{
  "name": "ethereum-json-rpc",
  "version": "1.0.0",
  "description": "An interactive reference of the Ethereum node API",
  "author": {
    "name": "Timur Badretdinov",
    "github": "https://github.com/Destiner"
  },
  "keywords": [
    "ethereum",
    "evm",
    "json-rpc",
    "devtools"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/Destiner/ethereum-json-rpc.git"
  },
  "scripts": {
    "generate:providers": "bun src/scripts/fetchProviders.ts",
    "build": "vite build",
    "dev": "vite",
    "lint": "bun run lint:prettier && bun run lint:eslint",
    "lint:prettier": "prettier -c \"src/**/*.{json,js,ts,vue}\"",
    "lint:eslint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit && vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@unhead/vue": "^3.4.0",
    "@vueuse/core": "^14.4.0",
    "evm-providers": "^0.6.1",
    "reka-ui": "^2.10.4",
    "viem": "^2.56.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
