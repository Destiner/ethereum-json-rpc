{
  "$schema": "https://unpkg.com/wrangler@4.167.0/config-schema.json",
  "name": "ethereum-json-rpc",
  "account_id": "94540d71e20e27bc2f813bbd79ced3e1",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "ethereum-json-rpc.com/*", "zone_name": "ethereum-json-rpc.com" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
